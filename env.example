# ID de la hoja de Google Sheets "Cronograma ILCE" (lo sacás de la URL del Sheet)
GOOGLE_SHEET_ID=

# Cuenta de servicio (misma que ya usás en Carga de Clases / Seguimiento Lead)
GOOGLE_SERVICE_ACCOUNT_EMAIL=carga-clases-bot@carga-clases-ilce.iam.gserviceaccount.com

# La private_key del JSON de la cuenta de servicio, tal cual (con los \n literales,
# Vercel la interpreta bien si la pegás con comillas dobles alrededor)
GOOGLE_PRIVATE_KEY=

# Secreto para firmar la cookie de sesión (cualquier string largo y random)
SESSION_SECRET=

# ID de una carpeta de Google Drive compartida como Editor con la cuenta de servicio de
# arriba — ahí se guardan los archivos que se suben desde la columna "Archivos" del
# tablero (Sheets no puede guardar binarios). Ver SETUP.md, punto 2.1.
GOOGLE_DRIVE_FOLDER_ID=

# Llave temporal para asignar la PRIMERA contraseña de cada usuario (vía /setup-password).
# Elegí cualquier texto largo y random. Una vez que todos tengan contraseña, la podés borrar
# o cambiar — no se usa para nada más.
SETUP_BOOTSTRAP_KEY=

# Cuenta de Gmail para mandar el resumen semanal (misma que usás en tus otras apps)
GMAIL_USER=coachingeducacionallider@gmail.com
GMAIL_APP_PASSWORD=

# Protege el endpoint del cron semanal (texto largo random)
CRON_SECRET=
